# Somente servidor. Nenhum segredo usa NEXT_PUBLIC_.
APP_URL=http://localhost:3000
SUPABASE_URL=
# Aceita sb_secret_ (preferido) ou service_role legado; somente servidor.
SUPABASE_SERVICE_ROLE_KEY=
PIN_HASH=
SESSION_SECRET=
# Código de recuperação de alta entropia; guarde somente hash SHA-256.
DEVICE_BOOTSTRAP_HASH=
# E-mail exato da empresa. OTP não aceita destinatário do cliente.
AUTHORIZED_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
# Em desenvolvimento: disabled; em produção: resend.
EMAIL_MODE=disabled
CRON_SECRET=
DATABASE_URL=

# Opcional: verificações negativas de acesso; não substitui a chave de servidor.
SUPABASE_PUBLISHABLE_KEY=
