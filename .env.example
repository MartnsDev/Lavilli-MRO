# Somente servidor. Nenhum segredo usa NEXT_PUBLIC_.
APP_URL=http://localhost:3000
SUPABASE_URL=
# Aceita sb_secret_ (preferido) ou service_role legado; somente servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Use o formato portável gerado por configure:pin; evita expansão de $ pelo Next.
PIN_HASH=
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Em desenvolvimento: disabled; em produção: resend.
EMAIL_MODE=disabled
CRON_SECRET=
DATABASE_URL=

# Opcional: verificações negativas de acesso; não substitui a chave de servidor.
SUPABASE_PUBLISHABLE_KEY=

# normal: backend do ambiente; demo/test: somente Supabase loopback.
APP_MODE=normal
# Confirmar true somente APÓS ativar proteção real do Preview na Vercel.
PREVIEW_PROTECTED=false
# Backup executado em worker privado, nunca no navegador/Vercel filesystem.
BACKUP_KEY_FILE=
PG_DUMP_BIN=pg_dump
# Restauração somente em destino isolado, com autorização separada.
RESTORE_SUPABASE_URL=
RESTORE_SERVICE_ROLE_KEY=
RESTORE_PROJECT_REF=
ALLOW_ISOLATED_RESTORE=NO
# Worker externo: clamscan ou clamdscan; assinaturas com no máximo 3 dias.
CLAM_SCAN_BIN=clamscan
